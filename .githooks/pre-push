#!/bin/sh
# Fast CI gate before every push: typecheck + tests (npm run prepush).
# Enabled per clone with `git config core.hooksPath .githooks`; see
# AGENTS.md. Bypass deliberately with `git push --no-verify`.
#
# Code scanning is not here: GitHub runs it on the push itself, and its
# toolchain is a 686 MB bundle. `npm run prepush:full` is both gates, for a
# machine that has one; `npm run codeql` is the analysis on its own.
set -u

if [ ! -x node_modules/.bin/tsc ]; then
    echo "pre-push: dependencies missing -- run 'npm install' first" >&2
    exit 1
fi

echo "pre-push: running the fast CI gate (npm run prepush)…"
if ! npm run prepush; then
    echo "pre-push: gate failed. Fix the failure, or bypass deliberately with --no-verify." >&2
    exit 1
fi
exit 0

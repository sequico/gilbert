#!/bin/sh
# Pre-push gate, driven by `scripts/gate-prepush.sh` (see AGENTS.md).
#
# Default: the full gate (`npm run check:ci`). `GATE=fast` runs only
# typecheck+lint; `GATE=off` skips. It also skips when nothing a gate reads
# changed, or when this exact tree already passed. Enabled per clone with
# `git config core.hooksPath .githooks`; bypass a run deliberately with
# `git push --no-verify`.
#
# CodeQL is not here: its toolchain is a 686 MB bundle, so it runs with the
# release and weekly (codeql.yml), not on every push. What GitHub does run on
# the push is the security workflow (ci-security.yml). `npm run prepush:full` is
# both gates, for a machine that has one; `npm run codeql` is the analysis on
# its own.
set -u

if [ ! -x node_modules/.bin/tsc ]; then
	echo "pre-push: dependencies missing -- run 'npm install' first" >&2
	exit 1
fi

exec bash scripts/gate-prepush.sh

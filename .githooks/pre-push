#!/bin/sh
# Pre-push gate, driven by `scripts/gate-prepush.sh` (see AGENTS.md, "Verification").
#
# Default: the affected gate — only the areas the pushed diff touches, their
# independent steps in parallel (`scripts/gate-lib.sh`). `GATE=full` runs the
# whole gate (`npm run check:ci`), `GATE=fast` only typecheck+lint, `GATE=off`
# skips. It also skips when nothing a gate reads changed, or when this exact
# tree already passed with those areas. Enabled per clone with
# `git config core.hooksPath .githooks`; bypass a run deliberately with
# `git push --no-verify`.
#
# CodeQL is not here: its toolchain is a 686 MB bundle, so it runs with the
# release and weekly (codeql.yml), not on every push. What GitHub does run on
# the push is the security workflow (ci-security.yml). `npm run prepush:full` is
# an alias of `check:ci`; CodeQL runs on GitHub only, never here.
# its own.
set -u

if [ ! -x node_modules/.bin/tsc ]; then
	echo "pre-push: dependencies missing -- run 'npm install' first" >&2
	exit 1
fi

exec bash scripts/gate-prepush.sh

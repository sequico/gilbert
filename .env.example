# ---- Agent worker (ADR 0003) ----

# Gilbert's own agent: a Stalwart account that acts inside mail and file
# storage for the groups it is granted. The worker is a second process from the
# same image, and it needs nothing here but the address and the secret.
#
#   npm run dev:mock:agent          # the demo stack, agent included
#   docker compose --profile agent up
#
# Create the account and grant it on a group in Stalwart's own administration
# (membership is the grant -- Gilbert never writes one), then give it an app
# password from the "Agents" section of the Gilbert admin. That surface
# verifies the grant per group and says plainly when it is missing.
GILBERT_AGENT_ADDRESS=gilbert@example.com
GILBERT_AGENT_PASSWORD=

# Optional: read the same pair from a mounted file instead of the environment.
# The `STALWART_SERVERS_FILE` shape -- see gilbert-agents.example.json.
# GILBERT_AGENTS_FILE=/etc/gilbert/agents.json

# Which areas this worker serves: mail, files, tasks, calendars, contacts.
# Unset means all of them. A busy area is another worker with its own areas,
# coordinated by lease on the documents -- never a supervisor.
# GILBERT_AGENT_AREAS=mail,files

# Where the worker answers a health probe, or unset for no listening socket at
# all. A deployment with a restart policy wants it: `restart` revives a dead
# process, the probe catches one that is up and holding no claim.
# GILBERT_AGENT_HEALTH_PORT=8081

# Push is the wake-up and these timers are the fallback and the liveness: how
# often a worker re-reads an account it was not pushed about (ms), how often it
# says it is alive, and how long a claim may go un-renewed before another
# worker takes it over. The lease is deliberately much longer than the
# heartbeat: an agent's work can sit in a model call or wait on a person, and a
# takeover during a legitimate pause would run the same job twice.
GILBERT_AGENT_POLL_MS=60000
GILBERT_AGENT_HEARTBEAT_MS=30000
GILBERT_AGENT_LEASE_MS=180000

# ---- Gilbert server configuration ----

# Base URL of your Stalwart server (scheme + host, no path). Gilbert discovers
# the JMAP session at <STALWART_URL>/.well-known/jmap.
STALWART_URL=https://mail.example.com

# Random secret used to derive encryption keys for persisted sessions.
# Generate with: openssl rand -base64 48
APP_SECRET=change-me

# Listen address
HOST=0.0.0.0
PORT=8080

# Serve the app from a subpath instead of the domain root, for a reverse proxy
# that maps https://example.com/mail/ here. Leave it unset for the root, which
# is what every deployment gets unless it asks otherwise. "/mail", "mail" and
# "/mail/" all mean the same thing.
#
# The prefix must reach Gilbert intact -- do not strip it in the proxy -- and
# it has to be set for the *build* as well as the run: the web bundle writes
# its own asset URLs, so a build that does not know the prefix produces an app
# that cannot load itself under one. With Docker that means
# `--build-arg BASE_PATH=/mail` alongside `-e BASE_PATH=/mail`.
# BASE_PATH=/mail

# Set to "1" when running behind a TLS-terminating reverse proxy (trusts
# X-Forwarded-* and marks cookies Secure). Set to "0" for plain-HTTP dev.
TRUST_PROXY=1
# Peers whose X-Forwarded-* headers are believed. Unset means loopback and the
# private ranges, which covers a reverse proxy on the same host or Docker
# network. A request from anywhere else is attributed to its socket address,
# whatever the headers claim -- otherwise anyone could pick their own key for
# the login rate limiter.
# TRUSTED_PROXIES=10.0.0.0/8,192.168.1.5
SECURE_COOKIES=auto

# Session lifetime (idle timeout) in seconds. "Remember me" extends to SESSION_REMEMBER_TTL.
SESSION_TTL=43200
SESSION_REMEMBER_TTL=2592000

# Where to persist sessions so restarts don't log everyone out (optional).
# Leave it empty to hold sessions in memory only, which is what an immutable
# instance does -- see IMMUTABLE below.
SESSION_FILE=./data/sessions.json

# Assert that this instance is running as an immutable container: read-only
# root filesystem, no durable state of its own. It is checked rather than
# taken on trust -- the server refuses to start if SESSION_FILE is set, or if
# the filesystem it is installed on turns out to be writable. Off by default.
# Running one looks like:
#   docker run --read-only --tmpfs /tmp -e IMMUTABLE=1 -e SESSION_FILE= ...
# The cost today is that a restart signs everyone out, since there is nowhere
# left to keep the sessions. Removing that cost is what the OAuth work is for.
# IMMUTABLE=1

# Upstream timeouts / limits
UPSTREAM_TIMEOUT=30000
MAX_UPLOAD_BYTES=52428800

# Remote-image privacy proxy (Gmail-style). Set to 0 to load remote images directly.
IMAGE_PROXY=1

# Live updates without a per-tab upstream connection (RFC 8620 push). Gilbert
# registers one subscription per account and fans Stalwart's StateChange POSTs
# out to that account's open tabs, so a reconnect is local instead of a fresh
# dial to Stalwart -- and a deployment's open-connection count stops tracking
# its open tabs.
#
# There is no address to configure. The origin Stalwart POSTs back to is derived
# from the request itself (server/src/app.ts, pushOrigin), and only when that
# request is believable: it arrived over https -- RFC 8620 requires the scheme --
# from a proxy we run, i.e. TRUST_PROXY is on and the peer address is inside
# TRUSTED_PROXIES. A Gilbert reached directly, or over plain http, keeps the
# per-tab relay for every account: nothing is lost, reconnecting is simply not
# local.
#
# To see what an account actually got, GET /api/health reports `push`: the
# counts verified/pending/failed, and `tabs` split into `fanout` and `relay`.
#
# "relay" keeps the per-tab upstream stream and never subscribes. The default,
# "subscribe", uses fan-out once an account verifies and keeps the relay for
# every account that does not.
# PUSH_MODE=subscribe

# Branding
APP_NAME=Gilbert

# Where this instance's source can be had. Gilbert is AGPL-3.0-or-later, which
# asks whoever runs a modified version to offer *that* version's source -- so if
# you have patched it, point this at your own tree. Shown on the sign-in page
# and in Settings > About.
SOURCE_URL=https://github.com/sequico/gilbert

# ---- Settings this installation decides (all optional) ----
#
# Seed what a new account starts on, lock what nobody may change, and turn
# something on once for accounts that already exist. Setting none of these --
# the default -- behaves exactly as Gilbert always has.
#
# A file is easier once there are `changes` in it. See the shipped
# settings-policy.example.json, and mount it read-only:
#
#   -v /srv/gilbert/policy.json:/etc/gilbert/policy.json:ro
#
# SETTINGS_POLICY_FILE=/etc/gilbert/policy.json
#
# Or inline, which is what an immutable deployment with no volume wants. These
# are ignored entirely when SETTINGS_POLICY_FILE is set, so a file and a stray
# variable cannot half-apply between them.
#
# SETTINGS_DEFAULTS={"externalSenderBanner":true}
# SETTINGS_ENFORCED={"externalRecipientConfirm":true}
# SETTINGS_CHANGES=[{"version":"20260902084513","settings":{"externalSenderBanner":true}}]
#
# Read once at startup: editing a policy means restarting the container.
# Docs: README.md#settings-the-installation-decides

# ---- Several Stalwart servers (optional) ----
#
# Choose the upstream by the domain someone signs in with. STALWART_URL above
# stays required and stays the default; this only adds domains that go
# elsewhere. See the shipped stalwart-servers.example.json, and mount it
# read-only:
#
#   -v /srv/gilbert/servers.json:/etc/gilbert/servers.json:ro
#
# STALWART_SERVERS_FILE=/etc/gilbert/servers.json
#
# An unlisted domain, or a username with no domain, goes to STALWART_URL. A
# listed domain never falls back. Read once at startup: editing means a restart.

# The bridge's API socket (ADR 0023). Bound to loopback: the only client is
# gilbertserver, which proxies the browser's WebSocket, so the API is never
# exposed — on a container network or on the host alike.
general: {
	json = "compact"
	ws = true
	ws_port = 8188
	ws_ip = "127.0.0.1"
	wss = false
}

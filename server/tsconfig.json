{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    /* Emitted by the build as well as by the gate: one cache, in a file git
       never sees, so a rebuild compiles what changed. */
    "incremental": true
  },
  "include": ["src"],
  /*
   * `src/mock` is NOT excluded: the in-memory Stalwart is shipped inside the
   * production image on purpose (owner decision 2026-10-18), so the image can
   * run a demo installation with no real mail server. It is a shipped part of
   * the product, not dead weight -- never add it here to "save" the build.
   */
  "exclude": ["src/**/*.test.ts", "src/testkit.ts"]
}

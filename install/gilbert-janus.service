# The phone's Janus bridge (ADR 0023), as a host service. Installed and
# started by install/install.sh; the application depends on it.
#
# Its only inbound port is the media range the administration names (see
# deploy/janus/janus.jcfg, generated from @gilbert/shared/phone): open it with
# `ufw allow 10000:10200/udp`, or the phone never appears. The API stays on
# loopback, and the SIP leg to the provider is outbound.
[Unit]
Description=Gilbert — the phone's Janus bridge
Documentation=https://github.com/sequico/gilbert
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
ExecStart=/usr/local/bin/janus
# The bridge's own libraries — the sonames a current distribution has moved past
# — travel beside it, so no Debian package is needed on this host.
Environment=LD_LIBRARY_PATH=/usr/local/lib/janus
Restart=on-failure
RestartSec=2
# The bridge holds nothing durable: the registration is the browser's, and a
# restart simply drops the calls in progress. Nothing here needs to write.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

# Gilbert, as a host service. Installed by install/install.sh.
#
# It runs with the bridge beside it (ADR 0023) but does not require it: with no
# bridge, or with its ports closed, the phone simply is not offered. The
# environment file carries the handshake and whatever else this deployment
# states (see .env.example); everything else lives in Stalwart.
[Unit]
Description=Gilbert
Documentation=https://github.com/sequico/gilbert
After=network-online.target gilbert-janus.service
Wants=network-online.target
Wants=gilbert-janus.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP@
EnvironmentFile=@ENV@
ExecStart=@NODE@ server/dist/index.js
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

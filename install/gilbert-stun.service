# The phone's STUN responder (ADR 0023), as a host service. Installed and
# started by install/install.sh, beside the Janus bridge.
#
# It answers the browser's STUN Binding request with the address its network
# gave it, so ICE has a server-reflexive candidate for the bridge; it relays
# nothing and holds nothing. Its only inbound port is the STUN port the
# administration names (see deploy/janus/janus.jcfg and scripts/stunConfig.mjs,
# both generated from @gilbert/shared/phone): open it with
# `ufw allow 3478/udp`.
#
# It runs in the foreground (no `-d`), so coturn writes no pid file.
[Unit]
Description=Gilbert — the phone's STUN responder
Documentation=https://github.com/sequico/gilbert
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
ExecStart=/usr/bin/turnserver -c /etc/gilbert/turnserver.conf
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    /*
     * The gate typechecks this tree and then builds it, and the build runs the
     * same `tsc` again (`build -w web`). Incremental turns the second run into a
     * comparison of file stamps instead of a re-parse of a thousand files: the
     * answers are identical, the cache lives in a file git never sees, and a
     * repeated gate pays for what changed rather than for the whole tree.
     */
    "incremental": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // What both tiers read as one definition: the documents the installation
      // keeps, the shapes and predicates that validate them, and the pure
      // helpers around them. They live in the server tree because the server is
      // the tier that validates and stores those documents. The client imports
      // them, never a copy (SSOT).
      "@gilbert/shared/*": ["../server/src/shared/*"],
      "@gilbert/agent/*": ["../server/src/agent/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // What both tiers read as one definition: the documents the installation
      // keeps, the shapes and predicates that validate them, and the pure
      // helpers around them. They live in the server tree because the server is
      // the tier that validates and stores those documents. The client imports
      // them, never a copy (SSOT).
      "@gilbert/shared/*": ["../server/src/shared/*"],
      "@gilbert/agent/*": ["../server/src/agent/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

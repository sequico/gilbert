{
  // OpenCode configuration for this repository.
  //
  // These settings travel with the clone: a fresh work machine gets the same
  // token-saving behaviour from this file alone. A value set here wins over the
  // same value in the global config (project configuration overrides global).
  "$schema": "https://opencode.ai/config.json",

  // Skills are the OpenCode default: directories under `.opencode/skills/` are
  // discovered automatically, so nothing has to be named here.

  // DeepSeek's context caching is automatic and provider-side: a repeated
  // request prefix is served from DeepSeek's cache, and the model catalog
  // already prices it (cache read is a fraction of input, cache write is 0).
  // There is no OpenCode switch to turn it on. The settings below are the token
  // savers OpenCode itself exposes.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 20000
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "providers": {
    "deepseek": {
      // Owner rule: every provider request must be zero-retention.
      "headers": { "X-Data-Opt-Out": "true" }
    }
  },

  // Working directories that are never source: a change under them must not
  // wake the session, and the built trees are large.
  "watcher": {
    "ignore": ["node_modules/**", "**/dist/**", ".worktree/**", "coverage/**"]
  }
}
